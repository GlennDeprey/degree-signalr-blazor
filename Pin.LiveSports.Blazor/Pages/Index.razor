@page "/"
@inject IMatchService MatchService
@inject NavigationManager NavigationManager

<PageTitle>Index</PageTitle>

<div class="container-xl">
    <div class="card p-1 mb-5" style="background-color: #0f0f0f;">
        <div class="embed-responsive embed-responsive-16by9" style="width:100%; height:500px;">
            <iframe class="embed-responsive-item" src="https://www.youtube.com/embed/ctvf2AkdRbs" style="width:100%; height:100%;" allowfullscreen></iframe>
        </div>
    </div>

    @if (isLoading)
    {
        <Loading />
    }
    else
    {
        if (!matches.Any())
        {
            <div class="card gradient-no-content p-2 d-flex justify-content-center">
                <div class="mx-4">
                    <h5 class="mb-0 text-light">No Matches Found</h5>
                    <p class="mb-0 text-lol">Check back soon to find played matches...</p>
                </div>
            </div>
        }
        else
        {
            @foreach (var group in matches.GroupBy(m => m.Created.Date))
            {
                <div class="card p-2 mb-5" style="background-color: #0f0f0f;">
                    <h5 class="card-header text-light" style="line-height: 24px; font-weight: 700;">@group.Key.ToString("dddd, dd MMMM")</h5>
                    <div class="card-body">
                        @foreach (var match in group)
                        {
                            <div class="card mb-3" style="background-color: #1c1c1c; line-height: 14px; font-weight: 700; border: 2px solid rgba(51, 51, 51, .25);">
                                <div class="card-body d-flex justify-content-center align-items-center text-light">
                                    <div class="team-name-logo">
                                        <span>@match.BlueTeam.ShortName</span>
                                        <img src="images/teams/@match.BlueTeam.SmallImageUrl" alt="@match.BlueTeam.Name" class="team-logo" />
                                    </div>
                                    <div class="score mx-3">@match.BlueTeamWins</div>
                                    <div class="score-separator">/</div>
                                    <div class="score mx-3">@match.RedTeamWins</div>
                                    <div class="team-name-logo">
                                        <img src="images/teams/@match.RedTeam.SmallImageUrl" alt="@match.RedTeam.Name" class="team-logo" />
                                        <span>@match.RedTeam.ShortName</span>
                                    </div>
                                </div>
                                <div class="card-footer d-flex justify-content-between align-items-center" style="background-color: rgba(0,0,0,0.2); color: #8C8C8C;">
                                    <img src="images/home/lec_small.png" class="align-self-start" alt="LEC Logo" />
                                    <div class="mx-auto">LEC</div>
                                    <div>@match.MatchType.ShortName</div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        }
    }
</div>

@code {
    private IList<MatchIndexViewModel> matches;
    private bool isLoading = true;
    private HubConnection hubConnection;

    protected override async Task OnInitializedAsync()
    {
        hubConnection = new HubConnectionBuilder()
            .WithUrl(NavigationManager.ToAbsoluteUri("/matchHub"))
            .Build();

        hubConnection.On(HubContants.ReceiveRefreshPlayedMatches, async () =>
        {
            isLoading = true;
            await PopulateMatchesAsync();
            await InvokeAsync(StateHasChanged);
        });

        await hubConnection.StartAsync();

        matches = new List<MatchIndexViewModel>();
        await PopulateMatchesAsync();
        await base.OnInitializedAsync();
    }

    public async Task PopulateMatchesAsync()
    {
        var matchesResult = await MatchService.GetMatchesAsync();
        if (matchesResult.IsSuccess)
        {
            matches = matchesResult.Data.Select(m => new MatchIndexViewModel
            {
                MatchType = new MatchTypeViewModel
                {
                    Id = m.MatchType.Id,
                    Name = m.MatchType.Name,
                    ShortName = m.MatchType.ShortName,
                },
                BlueTeam = new TeamDetailViewModel
                {
                    Id = m.BlueTeam.Id,
                    Name = m.BlueTeam.Name,
                    ShortName = m.BlueTeam.ShortName,
                    ImageUrl = m.BlueTeam.ImageUrl,
                    SmallImageUrl = m.BlueTeam.SmallImageUrl
                },
                RedTeam = new TeamDetailViewModel
                {
                    Id = m.RedTeam.Id,
                    Name = m.RedTeam.Name,
                    ShortName = m.RedTeam.ShortName,
                    ImageUrl = m.RedTeam.ImageUrl,
                    SmallImageUrl = m.RedTeam.SmallImageUrl
                },
                RedTeamWins = m.RedTeamWins,
                BlueTeamWins = m.BlueTeamWins,
                Created = m.Created,
            }).ToList();
        }

        isLoading = false;
    }
}