<div class="snackbar" style="display: @(IsVisible ? "block" : "none"); background-color: @BackgroundColor;">
    @if (!string.IsNullOrEmpty(Icon))
    {
    <span class="@Icon" style="margin-right: 8px;"></span>
    }
    @Message
</div>

@code {
    [Parameter]
    public string Message { get; set; }

    [Parameter]
    public string Icon { get; set; }

    [Parameter]
    public string BackgroundColor { get; set; }

    private bool IsVisible { get; set; }

    public async Task ShowAsync(string message, string icon = "", string backgroundColor = "#333", int duration = 5200)
    {
        Message = message;
        Icon = icon;
        BackgroundColor = backgroundColor;
        IsVisible = true;
        await InvokeAsync(StateHasChanged);

        await Task.Delay(duration);
        IsVisible = false;
        await InvokeAsync(StateHasChanged);
    }
}